FROM python:3.10

WORKDIR /app

# Copy requirements first
COPY services/retrieval/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the code
COPY services/retrieval/ /app/services/retrieval
COPY shared /app/shared

# Add /app to Python path so Python can find the modules
ENV PYTHONPATH=/app

CMD ["uvicorn", "services.retrieval.app:app", "--host", "0.0.0.0", "--port", "8001"]