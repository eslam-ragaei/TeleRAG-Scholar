FROM python:3.10

WORKDIR /app

COPY services/llm/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CHANGE THIS LINE - add the services/llm path
COPY services/llm/ /app/services/llm

# Add shared if your LLM service needs it
COPY shared /app/shared

ENV PYTHONPATH=/app

CMD ["uvicorn", "services.llm.app:app", "--host", "0.0.0.0", "--port", "8002"]